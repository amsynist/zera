<resources>
    <style name="Theme.Androp" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:fontFamily">@font/signal_mono</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/signal_background</item>
        <item name="android:navigationBarColor">@color/signal_background</item>
        <item name="android:windowBackground">@color/signal_background</item>
        <item name="colorPrimary">@color/signal_accent</item>
        <item name="colorOnPrimary">@color/signal_background</item>
        <item name="android:colorAccent">@color/signal_accent</item>
        <item name="colorOnSurface">@color/signal_text</item>
        <item name="materialButtonStyle">@style/Signal.Button</item>
        <item name="colorSurface">@color/signal_surface</item>
    </style>
    <style name="Signal.Button" parent="Widget.Material3.Button">
        <item name="android:fontFamily">@font/signal_semibold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="cornerRadius">7dp</item>
        <item name="android:minHeight">48dp</item>
    </style>
    <style name="Theme.Androp.Drop" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
    <style name="Androp.Eyebrow" parent="">
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/signal_secondary</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:fontFamily">@font/signal_semibold</item>
    </style>
    <style name="Androp.Body" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/signal_secondary</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>
</resources>
